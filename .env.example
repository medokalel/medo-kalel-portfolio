# Copy this file to ".env" and fill in your EmailJS values.
# (Vite only exposes variables that start with VITE_. EmailJS public keys are visible in the
#  browser by design, so restrict them to your domain in the EmailJS dashboard.)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=